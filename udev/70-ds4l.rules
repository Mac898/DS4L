# SPDX-License-Identifier: LGPL-3.0-or-later
#
# Optional. Most desktops already give the logged-in user access to the
# DualSense hidraw node. Install this if ds4ld logs "permission denied" on
# /dev/hidraw*:
#   sudo install -m644 udev/70-ds4l.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
#
# uaccess hands the node to whoever holds the active seat (logind or
# elogind). Without either, comment those lines out and use the GROUP lines,
# with your user in that group.

# DualSense (0ce6) and DualSense Edge (0df2), USB
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", TAG+="uaccess"
# Bluetooth
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", TAG+="uaccess"

#KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6|0df2", GROUP="input", MODE="0660"
#KERNEL=="hidraw*", KERNELS=="*054C:0CE6*|*054C:0DF2*", GROUP="input", MODE="0660"
